<UserControl x:Class="ProjetClient.View.ModificationLivre"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetClient.View"
             mc:Ignorable="d" 
             xmlns:viewmodel="clr-namespace:ProjetClient.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:ModificationVM}"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.6*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <GroupBox x:Name="head_livre" Grid.Column="0" Header="Selectionner un livre" BorderThickness="1" Margin="9">
            <ListView Foreground="{DynamicResource MaterialDesignBody}" FontFamily="{DynamicResource MaterialDesignFont}" 
                Background="{DynamicResource MaterialDesignPaper}" ItemsSource="{Binding LivreCollection}" SelectedItem="{Binding LivreSelectionner}">
                <ListView.View>
                    <GridView >
                        <GridViewColumn Header="ISBN" x:Name="listColumn_ISBN" Width="auto" DisplayMemberBinding="{Binding ISBN}"/>
                        <GridViewColumn Header="Titre" x:Name="listColumn_Titre"  Width="auto" DisplayMemberBinding="{Binding Titre}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <GroupBox x:Name="head_info" Header="Informations du livre" Grid.Column="1" Margin="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.6*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" VerticalAlignment="Center" >
                        <Label DockPanel.Dock="Left" Content="ISBN :"/>
                        <TextBox
                            Background="{DynamicResource MaterialDesignPaper}"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    FontFamily="{DynamicResource MaterialDesignFont}"
                    CaretBrush="{DynamicResource PrimaryHueMidBrush}"
                    SelectionBrush="{DynamicResource PrimaryHueLightBrush}"
                    Padding="8"
                            Width="190" HorizontalAlignment="Right" Text="{Binding LivreSelectionner.ISBN}"/>
                    </DockPanel>

                    <DockPanel Grid.Row="1" VerticalAlignment="Center" >
                        <Label x:Name="label_titre" Content="Titre :"/>
                        <TextBox
                            Background="{DynamicResource MaterialDesignPaper}"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    FontFamily="{DynamicResource MaterialDesignFont}"
                    CaretBrush="{DynamicResource PrimaryHueMidBrush}"
                    SelectionBrush="{DynamicResource PrimaryHueLightBrush}"
                    Padding="8"
                            Width="190" HorizontalAlignment="Right" Text="{Binding LivreSelectionner.Titre}"/>
                    </DockPanel>

                    <DockPanel Grid.Row="2" VerticalAlignment="Center">
                        <Label x:Name="label_nbPages" Content="Nombre de Pages :" HorizontalAlignment="Left"/>
                        <TextBox
                            Background="{DynamicResource MaterialDesignPaper}"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    FontFamily="{DynamicResource MaterialDesignFont}"
                    CaretBrush="{DynamicResource PrimaryHueMidBrush}"
                    SelectionBrush="{DynamicResource PrimaryHueLightBrush}"
                    Padding="8"
                            Width="190" HorizontalAlignment="Right" Text="{Binding LivreSelectionner.NbPages}"/>
                    </DockPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="0.2*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Label x:Name="label_auteur" Content="Auteur :"/>

                        <ListView ItemsSource="{Binding AuteurCollection}" SelectedItem="{Binding AuteurSelectionner}" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="{DynamicResource MaterialDesignFont}" 
                            Background="{DynamicResource MaterialDesignPaper}" HorizontalAlignment="Right">
                            <ListView.View>
                                <GridView >
                                    <GridViewColumn x:Name="listColumn_participantNom" Width="auto" DisplayMemberBinding="{Binding Nom}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <Button x:Name="btn_modif" Grid.Row="1" Margin="200,0,0,0" Content="Enregistrer les modifications" Command="{Binding EnregistrerCommand}"/>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
